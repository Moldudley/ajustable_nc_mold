    {
      "atomType": "GitHubMolecule",
      "x": 0.3,
      "y": 0.8,
      "uniqueID": "id-252",
      "name": "Nosecone_Haack_Series_notHollow",
      "ioValues": [
        {
          "name": "Length",
          "ioValue": 19.25
        },
        {
          "name": "Outer_Diameter",
          "ioValue": 6.825
        },
